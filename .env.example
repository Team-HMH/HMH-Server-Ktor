# 데이터베이스 설정
DB_HOST=localhost
DB_USER=hmh_user
DB_PASSWORD=your_db_password
DB_NAME=hmh

# JWT 설정
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_ISSUER=hmh-server
JWT_AUDIENCE=hmh-client

# 카카오 OAuth
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://your-domain.com/auth/kakao/callback

# 애플 OAuth
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_CLIENT_ID=your_apple_client_id

# Slack 웹훅 (선택사항)
SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_NEW_USER_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# CORS 설정
ALLOWED_HOSTS=localhost:3000,your-domain.com,your-app-name.herokuapp.com

# 배포 환경
DEPLOYMENT_GROUP_NAME=hmh-dev-deploy-group